<Page
    x:Class="VlessApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VlessApp"
    RequestedTheme="Dark">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedProfilesCVS" IsSourceGrouped="True"/>

        <!-- Стиль выпадающего меню добавления -->
        <Style x:Key="AddMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
            <Setter Property="Background" Value="#10172A"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,4,0,4"/>
        </Style>

        <!-- Объемный вертикальный градиент для ПОДКЛЮЧЕННОГО состояния -->
        <LinearGradientBrush x:Key="ButtonGlowConnected" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#0369A1" Offset="0.45"/>
            <GradientStop Color="#082F49" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Объемный вертикальный градиент для ОТКЛЮЧЕННОГО состояния -->
        <LinearGradientBrush x:Key="ButtonGlowDisconnected" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A2338" Offset="0.0"/>
            <GradientStop Color="#101728" Offset="0.5"/>
            <GradientStop Color="#0A0E1A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Шаблон карточки группы серверов (Fluent / Modern Card Style) -->
        <Style TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Border Background="#0E1424" CornerRadius="10" BorderBrush="#1A2338" BorderThickness="1" Margin="14,0,14,14" Padding="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <ItemsPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль круглой кнопки подключения с концентрическим свечением -->
        <Style x:Key="ConnectButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <Border x:Name="BackgroundBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="68"
                                Width="136" Height="136"/>

                            <!-- Внутренний оптический блик -->
                            <Border Margin="1" BorderBrush="#FFFFFF" BorderThickness="1" Opacity="0.08" CornerRadius="67" Width="134" Height="134"/>

                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Глубокий OLED-фон (экологичный для батареи и контрастный) -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#060812" Offset="0.0"/>
                <GradientStop Color="#0C101E" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Верхний бар и статус -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Главный Hero-блок (кнопка туннеля) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Вспомогательные действия и предупреждения -->
            <RowDefinition Height="*"/>
            <!-- 3. Список серверов -->
        </Grid.RowDefinitions>

        <!-- 0. ВЕРХНИЙ БАР ДЕЙСТВИЙ И СТАТУСА -->
        <Grid Grid.Row="0" Margin="14,8,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка настроек / О приложении -->
            <Button x:Name="SettingsBtn" Grid.Column="0" Click="SettingsBtn_Click" 
                    Background="Transparent" BorderThickness="0" Padding="8" 
                    Width="40" Height="40" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#94A3B8"/>
            </Button>

            <!-- Центральный видимый статус-бейдж -->
            <Border Grid.Column="1" Background="#0E1424" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="14" Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="240">
                <TextBlock x:Name="StatusText" Text="MetroBox готов" 
                           FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" 
                           TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Center"/>
            </Border>

            <!-- Кнопка добавления серверов -->
            <Button x:Name="AddBtn" Grid.Column="2" Background="Transparent" BorderThickness="0" 
                    Padding="8" Width="40" Height="40" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#94A3B8"/>
                <Button.Flyout>
                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AddMenuFlyoutPresenterStyle}">
                        <MenuFlyoutItem Text="📋  Импорт из буфера" Click="ImportFromClipboard_Click" Height="44"/>
                        <MenuFlyoutItem Text="📷  Сканировать QR-код" Click="ScanQrCode_Click" Height="44"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 1. СФЕРА ПОДКЛЮЧЕНИЯ С ВЫВЕРЕННЫМИ КОНЦЕНТРИЧЕСКИМИ КОЛЬЦАМИ -->
        <Grid Grid.Row="1" Height="216" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,6">
            <Border x:Name="GlowRing1" Width="200" Height="200" CornerRadius="100" BorderThickness="1" BorderBrush="#2563EB" Opacity="0.10"/>
            <Border x:Name="GlowRing2" Width="168" Height="168" CornerRadius="84" BorderThickness="1.5" BorderBrush="#2563EB" Opacity="0.22"/>

            <Button x:Name="ConnectBtn" Click="ConnectBtn_Click" Width="136" Height="136" 
                    Style="{StaticResource ConnectButtonStyle}" 
                    Background="{StaticResource ButtonGlowDisconnected}" 
                    BorderBrush="#2563EB" BorderThickness="2.5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="White" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ConnectBtnText" Text="ПОДКЛЮЧИТЬ" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. ВСПОМОГАТЕЛЬНЫЕ ДЕЙСТВИЯ И ПРЕДУПРЕЖДЕНИЯ -->
        <Grid Grid.Row="2" Margin="18,6,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!-- Проверка текущего подключения -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" 
                            Tapped="CheckConnection_Tapped" IsTapEnabled="True" Background="Transparent" Padding="0,4">
                    <FontIcon Glyph="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CheckConnectionText" Text="Проверить сеть" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Свернуть / развернуть все -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Tapped="HideAll_Tapped" IsTapEnabled="True" Background="Transparent" Padding="0,4">
                    <TextBlock x:Name="HideAllBtn" Text="Свернуть все" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Плашка предупреждения транспорта (XHTTP / CDN / Worker) -->
            <TextBlock x:Name="TransportWarnText" Grid.Row="1" Visibility="Collapsed" FontSize="11" Foreground="#F59E0B" LineHeight="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </Grid>

        <!-- 3. СПИСОК СЕРВЕРОВ -->
        <ListView Grid.Row="3" x:Name="ProfilesList" Margin="0,0,0,0" SelectionMode="None"
              ShowsScrollingPlaceholders="False"
              ItemsSource="{Binding Source={StaticResource GroupedProfilesCVS}}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <!-- Оформление шапки группы подписки -->
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:ProfileGroup">
                            <Grid Margin="14,12,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.ColumnSpan="3" Background="Transparent" Tapped="GroupHeader_Tapped" Tag="{x:Bind}"/>

                                <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind ArrowIcon, Mode=OneWay}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Top" Margin="0,4,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind LastUpdatedText, Mode=OneWay}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="{x:Bind AmneziaInfo, Mode=OneWay}" Visibility="{x:Bind AmneziaInfoVisibility, Mode=OneWay}" FontSize="10.5" Foreground="#38BDF8" Margin="0,2,0,4"/>

                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind InfoButtonsVisibility, Mode=OneWay}" Margin="0,2,0,4">
                                        <Border Tapped="InfoLink_Tapped" DataContext="{x:Bind}" Background="#1E293B" CornerRadius="6" Padding="6,3,8,3" Margin="0,0,8,0" IsTapEnabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#38BDF8" Margin="0,0,4,0"/>
                                                <TextBlock Text="Инфо" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Tapped="TelegramLink_Tapped" DataContext="{x:Bind}" Background="#1E293B" CornerRadius="6" Padding="6,3,8,3" IsTapEnabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#38BDF8" Margin="0,0,4,0"/>
                                                <TextBlock Text="Telegram" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" LineHeight="16" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Кнопки быстрых действий над группой -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Button Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="0,0,2,0" Click="UpdateSubscription_Click" DataContext="{x:Bind}">
                                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8"/>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="0,0,2,0" Click="PingGroup_Click" DataContext="{x:Bind}">
                                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8"/>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="0,0,2,0" Click="RenameSubscription_Click" DataContext="{x:Bind}">
                                        <FontIcon Glyph="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8"/>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Click="DeleteSubscription_Click" DataContext="{x:Bind}">
                                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <!-- Шаблон ячейки сервера -->
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:VlessProfile">
                    <Border BorderBrush="#161F33" BorderThickness="0,0,0,1">
                        <Grid Background="#0E1424" ManipulationMode="TranslateX,System" ManipulationDelta="Item_ManipulationDelta" ManipulationCompleted="Item_ManipulationCompleted">

                            <!-- Левая панель действий (Ping / Share) -->
                            <Grid Width="120" Height="56" HorizontalAlignment="Left" Background="#161F36">
                                <StackPanel Orientation="Horizontal" Visibility="{x:Bind DefaultActionsVisibility, Mode=OneWay}">
                                    <Button Width="60" Height="56" Background="#059669" BorderThickness="0" Padding="0" Click="SwipePing_Click" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Width="60" Height="56" Background="#4F46E5" BorderThickness="0" Padding="0" Click="SwipeShare_Click" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <Grid Visibility="{x:Bind SharePanelVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Width="40" Height="56" Click="ShareUrl_Click" Background="#4338CA" BorderThickness="0" Padding="0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="URL" FontSize="8" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Width="40" Height="56" Click="ShareQr_Click" Background="#4338CA" BorderThickness="1,0,1,0" BorderBrush="#1F264E" Padding="0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="QR" FontSize="8" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Width="40" Height="56" Click="ShareJson_Click" Background="#4338CA" BorderThickness="0" Padding="0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="JSON" FontSize="8" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- ПРАВАЯ ПАНЕЛЬ ДЕЙСТВИЙ: Кнопка удаления -->
                            <Grid Width="60" Height="56" HorizontalAlignment="Right" Background="#DC2626" Tapped="SwipeDelete_Click" Tag="{x:Bind}" IsTapEnabled="True">
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Верхний слой: Сам элемент сервера -->
                            <Grid x:Name="ContentGrid" Background="{x:Bind ItemBackgroundBrush, Mode=OneWay}" Tapped="Item_Tapped" IsTapEnabled="True" Loaded="ContentGrid_Loaded">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="Translation"/>
                                </Grid.RenderTransform>

                                <Border Width="3.5" CornerRadius="0,2,2,0" Background="#38BDF8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="{x:Bind SelectedIndicatorVisibility, Mode=OneWay}"/>

                                <Grid Padding="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Флаг страны / значок -->
                                    <Grid Grid.Column="0" Width="40" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border CornerRadius="4" BorderBrush="#2AFFFFFF" BorderThickness="1"
                                                Visibility="{x:Bind FlagVisibility, Mode=OneWay}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind FlagImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- Страна известна, но флага в наборе нет -->
                                        <Border CornerRadius="4" Background="#1A243A"
                                                Visibility="{x:Bind CodeBadgeVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind CountryBadgeText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="Bold" Foreground="#38BDF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Страна не определилась -->
                                        <Border CornerRadius="4" Background="#1A243A"
                                                Visibility="{x:Bind GlobeVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                      Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Название и протокол -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>

                                    <!-- Пинг и шеврон -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CleanPingText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind PingBrush, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <FontIcon Glyph="&#xE00F;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- СТРАНИЦА «О ПРИЛОЖЕНИИ» -->
        <Grid x:Name="AboutPageGrid" Grid.RowSpan="4" Visibility="Collapsed" Canvas.ZIndex="100">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#060812" Offset="0.0"/>
                    <GradientStop Color="#0C101E" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка страницы -->
            <Grid Grid.Row="0" Margin="14,10,14,10">
                <Button x:Name="AboutBackBtn" Click="AboutBackBtn_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="8" Width="40" Height="40">
                    <FontIcon Glyph="&#xE112;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#38BDF8"/>
                </Button>
                <TextBlock Text="О приложении" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Контентная карточка -->
            <ScrollViewer Grid.Row="1" Margin="14,6,14,14">
                <Border Background="#0E1424" CornerRadius="10" BorderBrush="#1A2338" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <!-- Название приложения (MetroBox) -->
                        <TextBlock Text="MetroBox" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        <Border Background="#162238" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" Margin="0,6,0,6">
                            <TextBlock Text="Версия 1.6.0.0 · Windows 10 Mobile" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                        <TextBlock Text="by LeenzeryDev" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Описание -->
                        <TextBlock Text="Высокопроизводительный VPN-клиент для Windows 10 Mobile с нативной поддержкой протоколов VLESS (REALITY, TLS, Vision), gRPC, Shadowsocks и AmneziaWG." 
                               FontSize="13.5" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,20"/>

                        <!-- Ссылки -->
                        <TextBlock Text="Связь и поддержка:" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <FontIcon Glyph="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="Telegram канал" NavigateUri="https://t.me/cmplog" Foreground="#38BDF8" Padding="0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <FontIcon Glyph="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="Тема на 4PDA" NavigateUri="https://4pda.to/forum/index.php?showuser=4458524" Foreground="#38BDF8" Padding="0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <FontIcon Glyph="&#xE181;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="Поддержать разработчика" NavigateUri="https://pay.cloudtips.ru/p/83821e32" Foreground="#38BDF8" Padding="0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>

                        <!-- Диагностика -->
                        <TextBlock Text="Диагностика:" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                        <TextBlock Text="Журнал очищается при каждом запуске приложения. Если возникли неполадки с подключением — отправьте журнал для разбора."
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>
                        <Button x:Name="ShareLogBtn" Click="ShareLogBtn_Click" HorizontalAlignment="Stretch"
                                Background="#162238" BorderBrush="#253556" BorderThickness="1" Padding="12,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <TextBlock Text="Отправить журнал" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ShareLogHint" Text="" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
